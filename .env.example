# Port for Express server to listen on
PORT=5000

# MongoDB Atlas connection string (replace with your credentials)
# Example: mongodb+srv://myUser:mySecretPassword@cluster0.abcde.mongodb.net/backendDB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backendDB?retryWrites=true&w=majority

# Application environment
NODE_ENV=development
