            "description": "Creates a new course assignment document in MongoDB."
          },
          "response": []
        },
        {
          "name": "2. Get All Assignments (READ)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assignments"]
            },
            "description": "Fetches all assignments from MongoDB sorted by due date."
