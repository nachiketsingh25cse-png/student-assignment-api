            "url": {
              "raw": "{{baseUrl}}/api/assignments/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assignments", "{{assignmentId}}"]
            },
            "description": "Updates an assignment document in MongoDB by its ID (e.g., mark as completed)."
