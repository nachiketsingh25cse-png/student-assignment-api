          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assignments?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assignments"],
              "query": [
                {
                  "key": "status",
